# Copia este archivo como .env.local y llena los valores.
# En Vercel: Project Settings → Environment Variables.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secreta: solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Clave para anonimizar las IP del límite de solicitudes de cotización (solo servidor).
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_HMAC_SECRET=

# Cloudflare Turnstile (anti-spam de formularios)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (avisos por correo de nuevas cotizaciones)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Sitio web <notificaciones@rahamperycontreras.mx>"
QUOTE_NOTIFY_EMAIL=tu-correo@ejemplo.com
